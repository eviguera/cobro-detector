# CobroDetector — Environment Variables
# Copiar a .env y completar con valores reales
# Ver cobro-detector/.env.example para descripciones detalladas

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...  # Usada por microservicios para crear cliente con JWT del usuario (RLS)

# Groq
GROQ_API_KEY=gsk_...

# Upstash Redis
UPSTASH_REDIS_URL=https://xxxx.upstash.io
UPSTASH_REDIS_TOKEN=xxx

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...
MERCADOPAGO_WEBHOOK_SECRET=xxx

# Resend (notificaciones)
RESEND_API_KEY=re_...

# Sentry (monitoreo de errores backend — opcional)
SENTRY_DSN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# E2E Tests (Playwright)
# Ejecutar con: TEST_EMAIL=... TEST_PASSWORD=... npx playwright test
E2E_URL=http://localhost:3000
TEST_EMAIL=
TEST_PASSWORD=

# URLs individuales de microservicios para el frontend (desarrollo local)
NEXT_PUBLIC_ANALYSIS_SVC_URL=http://localhost:4000
NEXT_PUBLIC_PAYMENT_SVC_URL=http://localhost:5000
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_SVC_URL=http://localhost:6000

# Microservicios URLs (Docker compose — apuntan al nombre del servicio)
# En producción, reemplazar por las URLs públicas de cada microservicio desplegado.
# Ejemplo: PAYMENT_SERVICE_URL=https://payment-svc.xxx.vercel.app
ANALYSIS_SERVICE_URL=http://analysis-svc:3001
PAYMENT_SERVICE_URL=http://payment-svc:3002
NOTIFICATION_SERVICE_URL=http://notification-svc:3003
ADMIN_SERVICE_URL=http://admin-svc:3005

# URL pública del payment-svc para notificaciones webhook de MercadoPago.
# Debe ser la URL pública del payment-svc (ej: https://payment-svc.xxx.vercel.app).
# Usada por payment-svc para construir notification_url en preferencias de MercadoPago.
PAYMENT_SVC_PUBLIC_URL=

# Storage de archivos de análisis
# supabase (default) | s3. El frontend y el servidor deben usar el mismo valor.
NEXT_PUBLIC_STORAGE_DRIVER=supabase
STORAGE_DRIVER=supabase
# TTL de URLs firmadas de descarga (segundos).
NEXT_PUBLIC_STORAGE_URL_TTL_SECONDS=3600

# KEK para envelope encryption de la clave AES-256-GCM de cada análisis.
# Misma clave (base64, 32 bytes) en frontend server y analysis-svc.
# Si se omite: modo legado (la clave de archivo se guarda en texto plano en DB).
# Generar: openssl rand -base64 32
ANALYSIS_KEY_ENCRYPTION_KEY=

# S3 / S3-compatible (solo con STORAGE_DRIVER=s3). Las credenciales viven en
# el servidor de Next.js (Vercel env vars), nunca en el navegador.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
NEXT_PUBLIC_S3_ENDPOINT=
S3_AUTO_CREATE_BUCKET=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
