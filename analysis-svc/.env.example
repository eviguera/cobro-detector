SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key
PORT=3001

SUPABASE_ANON_KEY=

# Cola de análisis (worker). Defaults razonables; solo sobrescribir si hace falta.
REDIS_URL=redis://localhost:6379
QUEUE_MAX_ATTEMPTS=3
# Segundos antes de que el reaper considere huérfano un job en procesamiento.
# Debe superar la duración máxima de un análisis (default 600 = 10 min).
QUEUE_STALE_SECONDS=600
QUEUE_REAP_INTERVAL_SECONDS=60
QUEUE_POLL_INTERVAL_MS=500
# Segundos máximos de espera en el apagado elegante antes de salir forzado.
QUEUE_HARD_SHUTDOWN_SECONDS=30

# En producción: orígenes permitidos del frontend y monitoreo de errores.
CORS_ORIGINS=
SENTRY_DSN=

# Storage de archivos de análisis: el worker debe aceptar las URLs firmadas del
# mismo backend que usa el frontend. Con `supabase` no hace falta nada más.
# Con `s3`, configurar el endpoint y el bucket para que la allowlist SSRF acepte
# las URLs prefirmadas (AWS/R2 se detectan por host; un S3 compatible como
# MinIO o el emulador local requiere S3_ENDPOINT).
STORAGE_DRIVER=supabase
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# KEK para envelope encryption de la clave AES-256-GCM de cada análisis.
# DEBE ser la misma clave (base64, 32 bytes) que en el frontend server.
# Sin ella, las claves nuevas se guardarán en modo legado y las filas ya
# envueltas (v1:...) no podrán descifrarse.
# Generar: openssl rand -base64 32
ANALYSIS_KEY_ENCRYPTION_KEY=
