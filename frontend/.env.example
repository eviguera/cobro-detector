# Supabase (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-del-proyecto>

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Microservicios base URL (se usa para todos los servicios si son el mismo host)
# NEXT_PUBLIC_API_URL=http://localhost:3004
# O URLs individuales (deben coincidir con los puertos publicados en docker-compose.yml):
NEXT_PUBLIC_ANALYSIS_SVC_URL=http://localhost:3001
NEXT_PUBLIC_PAYMENT_SVC_URL=http://localhost:3002
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_SVC_URL=http://localhost:3005

# MercadoPago (solo frontend keys)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxx

# Storage de archivos de análisis
# supabase (default, producción) | s3
NEXT_PUBLIC_STORAGE_DRIVER=supabase
# Solo lado servidor; si se omite cae a NEXT_PUBLIC_STORAGE_DRIVER.
STORAGE_DRIVER=supabase
# TTL de las URLs firmadas de descarga, en segundos (60–3600).
NEXT_PUBLIC_STORAGE_URL_TTL_SECONDS=3600

# KEK para envelope encryption de la clave AES-256-GCM de cada análisis.
# Misma clave (base64, 32 bytes) en frontend server y analysis-svc.
# Si se omite: modo legado (la clave de archivo se guarda en texto plano en DB).
# Generar: openssl rand -base64 32
ANALYSIS_KEY_ENCRYPTION_KEY=

# S3 / S3-compatible (solo si el driver es s3). Las credenciales viven en el
# servidor (route handlers); NUNCA uses el prefijo NEXT_PUBLIC_ con secretos.
S3_BUCKET=
S3_REGION=us-east-1
# Endpoint alternativo (MinIO, emulador local, R2). Vacío = AWS.
S3_ENDPOINT=
# Copia pública del endpoint para que el navegador arme la URL prefirmada
# (solo desarrollo; en producción no se necesita porque se usa AWS).
NEXT_PUBLIC_S3_ENDPOINT=
# Crea el bucket al arrancar si no existe (útil con emulador/MinIO; en AWS
# normalmente el bucket ya existe y el rol no tiene s3:CreateBucket).
S3_AUTO_CREATE_BUCKET=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# E2E Tests: las credenciales se inyectan por entorno (nunca en el repo).
# Local: TEST_EMAIL=... TEST_PASSWORD=... npx playwright test
# CI: secrets TEST_EMAIL / TEST_PASSWORD
TEST_EMAIL=
TEST_PASSWORD=
